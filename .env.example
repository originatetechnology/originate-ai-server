# ─── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Meta (Instagram + Messenger + WhatsApp) ──────────────────────────────────
# Get from: developers.facebook.com → Your App → WhatsApp / Messenger
WEBHOOK_VERIFY_TOKEN=           # any secret string you set in Meta dashboard

# Facebook / Instagram Messenger
FB_PAGE_TOKEN=                  # Page Access Token from Meta App dashboard

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=       # From: Meta App → WhatsApp → API Setup
WHATSAPP_TOKEN=                 # System User token (or temporary test token)

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
# Get from: console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # Your Twilio number, e.g. +16175550000

# ─── Agent Approval Channels ──────────────────────────────────────────────────
# The agent's contact info — drafts get sent here for approval before sending
# Set the number/ID for whichever channel(s) you want to use

AGENT_WHATSAPP_NUMBER=          # Agent's WhatsApp number, e.g. +16175559999
AGENT_SMS_NUMBER=               # Agent's phone number for SMS approval
AGENT_META_ID=                  # Agent's Facebook/Instagram page-scoped user ID

# ─── Listings Data ────────────────────────────────────────────────────────────
# Optional: URL to a JSON endpoint or Google Sheet with live listing data
# Falls back to hardcoded Burlington MA listing if not set
LISTINGS_SHEET_URL=
